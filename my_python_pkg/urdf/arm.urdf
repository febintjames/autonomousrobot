<?xml version="1.0"?>
<robot name="inspection_arm">
  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>
  <material name="orange">
    <color rgba="1 0.5 0 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
      <origin xyz="0 0 0.025"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
      <origin xyz="0 0 0.025"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025"/>
      <mass value="1.0"/>
      <inertia
          ixx="0.001"
          ixy="0"
          ixz="0"
          iyy="0.001"
          iyz="0"
          izz="0.001"/>
    </inertial>
  </link>

  <link name="arm_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.3"/>
      </geometry>
      <origin xyz="0 0 0.15"/>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.3"/>
      </geometry>
      <origin xyz="0 0 0.15"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="0.5"/>
      <inertia
          ixx="0.002"
          ixy="0"
          ixz="0"
          iyy="0.002"
          iyz="0"
          izz="0.0001"/>
    </inertial>
  </link>

  <!-- Revolute Joint -->

  <joint name="base_arm_joint" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 1 0"/>
    <limit
        lower="-1.57"
        upper="1.57"
        effort="10"
        velocity="1"/>
  </joint>

  <!-- Gazebo Colors -->

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="arm_link">
    <material>Gazebo/Orange</material>
  </gazebo>
  <!-- Joint Controller -->

  <gazebo>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>base_arm_joint</joint_name>
      <p_gain>5.0</p_gain>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher -->

  <gazebo>
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>base_arm_joint</joint_name>
    </plugin>
  </gazebo>
</robot>