<?xml version="1.0"?>
<robot name="practice_arm">

    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <link name="base_link">
        <visual>
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.4 0.4 0.1"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.4 0.4 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <mass value="10.0"/>
            <inertia ixx="0.141667" ixy="0.0" ixz="0.0" iyy="0.141667" iyz="0.0" izz="0.266667"/>
        </inertial>
    </link>

    <joint name="base_shoulder_joint" type="revolute">
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="shoulder_link"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.14" upper="3.14" effort="100.0" velocity="100.0"/>
    </joint>

    <link name="shoulder_link">
        <visual>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.1" length="0.5"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.2 0.2 0.5"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <mass value="5.0"/>
            <inertia ixx="0.116667" ixy="0.0" ixz="0.0" iyy="0.116667" iyz="0.0" izz="0.025"/>
        </inertial>
    </link>

    <joint name="shoulder_arm_joint" type="revolute">
        <origin xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0"/>
        <parent link="shoulder_link"/>
        <child link="arm_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="0.0" upper="2.5" effort="100.0" velocity="100.0"/>
    </joint>

    <link name="arm_link">
        <visual>
            <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.05" length="0.6"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.6"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0"/>
            <mass value="3.0"/>
            <inertia ixx="0.091875" ixy="0.0" ixz="0.0" iyy="0.091875" iyz="0.0" izz="0.00375"/>
        </inertial>
    </link>

    <joint name="arm_elbow_joint" type="revolute">
        <origin xyz="0.0 0.0 0.6" rpy="0.0 0.0 0.0"/>
        <parent link="arm_link"/>
        <child link="elbow_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="0.0" upper="2.5" effort="100.0" velocity="100.0"/>
    </joint>
    
    <link name="elbow_link">
        <visual>
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.05" length="0.1"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.001458" ixy="0.0" ixz="0.0" iyy="0.001458" iyz="0.0" izz="0.00125"/>
        </inertial>
    </link>

    <joint name="elbow_forearm_joint" type="revolute">
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
        <parent link="elbow_link"/>
        <child link="forearm_link"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.14" upper="3.14" effort="100.0" velocity="100.0"/>
    </joint>
    
    <link name="forearm_link">
        <visual>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.05" length="0.5"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.5"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <mass value="2.0"/>
            <inertia ixx="0.042917" ixy="0.0" ixz="0.0" iyy="0.042917" iyz="0.0" izz="0.0025"/>
        </inertial>
    </link>

    <joint name="forearm_wrist_joint" type="revolute">
        <origin xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0"/>
        <parent link="forearm_link"/>
        <child link="wrist_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="-1.57" upper="1.57" effort="100.0" velocity="100.0"/>
    </joint>
    
    <link name="wrist_link">
        <visual>
            <origin xyz="0.0 0.0 0.025" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.025" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.025" rpy="0.0 0.0 0.0"/>
            <mass value="0.5"/>
            <inertia ixx="0.000521" ixy="0.0" ixz="0.0" iyy="0.000521" iyz="0.0" izz="0.000833"/>
        </inertial>
    </link>

    <joint name="wrist_hand_joint" type="revolute">
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
        <parent link="wrist_link"/>
        <child link="hand_link"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-1.57" upper="1.57" effort="100.0" velocity="100.0"/>
    </joint>

    <link name="hand_link">
        <visual>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.02"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <mass value="0.5"/>
            <inertia ixx="0.000433" ixy="0.0" ixz="0.0" iyy="0.000433" iyz="0.0" izz="0.000833"/>
        </inertial>
    </link>

    <joint name="hand_tool_joint" type="fixed">
        <origin xyz="0.0 0.0 0.02" rpy="0.0 0.0 0.0"/>
        <parent link="hand_link"/>
        <child link="tool_link"/>
    </joint>

    <link name="tool_link">
        <visual>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
            <material name="white"/>
        </visual>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
        </inertial>
    </link>

    <joint name="tool_gripper_mount_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="tool_link"/>
        <child link="gripper_base_link"/>
    </joint>

    <link name="gripper_base_link">
        <visual>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.12 0.04 0.02"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.12 0.04 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <mass value="0.3"/>
            <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00037" iyz="0.0" izz="0.0004"/>
        </inertial>
    </link>

    <joint name="gripper_left_finger_joint" type="prismatic">
        <origin xyz="-0.04 0.0 0.02" rpy="0.0 0.0 0.0"/>
        <parent link="gripper_base_link"/>
        <child link="left_finger_link"/>
        <axis xyz="1.0 0.0 0.0"/>
        <limit lower="0.0" upper="0.04" effort="100.0" velocity="100.0"/>
    </joint>

    <link name="left_finger_link">
        <visual>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.02 0.02 0.08"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.02 0.02 0.08"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <mass value="0.1"/>
            <inertia ixx="0.000056" ixy="0.0" ixz="0.0" iyy="0.000056" iyz="0.0" izz="0.000007"/>
        </inertial>
    </link>

    <joint name="gripper_right_finger_joint" type="prismatic">
        <origin xyz="0.04 0.0 0.02" rpy="0.0 0.0 0.0"/>
        <parent link="gripper_base_link"/>
        <child link="right_finger_link"/>
        <axis xyz="-1.0 0.0 0.0"/>
        <limit lower="0.0" upper="0.04" effort="100.0" velocity="100.0"/>
        <mimic joint="gripper_left_finger_joint" multiplier="1.0" offset="0.0"/>
    </joint>

    <link name="right_finger_link">
        <visual>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.02 0.02 0.08"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.02 0.02 0.08"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <mass value="0.1"/>
            <inertia ixx="0.000056" ixy="0.0" ixz="0.0" iyy="0.000056" iyz="0.0" izz="0.000007"/>
        </inertial>
    </link>

    <joint name="left_finger_pad_joint" type="fixed">
        <origin xyz="0.0 0.0 0.08" rpy="0.0 0.0 0.0"/>
        <parent link="left_finger_link"/>
        <child link="left_pad_link"/>
    </joint>

    <link name="left_pad_link">
        <visual>
            <origin xyz="0.005 0.0 -0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.01 0.03 0.02"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0.005 0.0 -0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.01 0.03 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.005 0.0 -0.01" rpy="0.0 0.0 0.0"/>
            <mass value="0.02"/>
            <inertia ixx="0.000002" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000002"/>
        </inertial>
    </link>

    <joint name="right_finger_pad_joint" type="fixed">
        <origin xyz="0.0 0.0 0.08" rpy="0.0 0.0 0.0"/>
        <parent link="right_finger_link"/>
        <child link="right_pad_link"/>
    </joint>

    <link name="right_pad_link">
        <visual>
            <origin xyz="-0.005 0.0 -0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.01 0.03 0.02"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="-0.005 0.0 -0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.01 0.03 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="-0.005 0.0 -0.01" rpy="0.0 0.0 0.0"/>
            <mass value="0.02"/>
            <inertia ixx="0.000002" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000002"/>
        </inertial>
